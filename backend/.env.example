# SQLite database file path (relative to backend/ directory)
DATABASE_PATH=data/job_tracker.db

# Public API metadata
APP_NAME="SuperSQA Job Tracker"
API_VERSION=v1
ENVIRONMENT=local

# Comma-separated origins allowed for CORS
CORS_ORIGINS=http://localhost:8050

# API host/port for local development
HOST=0.0.0.0
PORT=3050

# JWT authentication
# Change this in real deployments. Keep course examples stable by documenting
# the default seeded users instead of relying on generated tokens.
JWT_SECRET_KEY=change-this-dev-secret-value-with-32-plus-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# In-memory rate limiting for local course fixture mode
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEMO_PER_MINUTE=2
